# ─── Better Auth ──────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BETTER_AUTH_SECRET=your_64_char_random_secret

# Server-side — used by auth.ts (not visible in browser)
BETTER_AUTH_URL=http://localhost:3000

# Browser-side — used by auth-client.ts (must have NEXT_PUBLIC_ prefix)
# Keep same value as BETTER_AUTH_URL
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=verify-full

# ─── Express API Server ───────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=http://localhost:5000

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Add to Google Console → Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-app.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Image Upload ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_IMGBB_API_KEY=
